{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MySqlServerVersion": "8.4.0"
  },
  "ConnectionStrings": {
    "KodingTask": "Data Source=App_Data/kodingtask.db"
  },
  "PublicSite": {
    "Url": "https://klakodingtask.mourafelipe.com",
    "RepositoryUrl": "",
    "AuthorName": "Felipe Moura",
    "AuthorUrl": "https://mourafelipe.com"
  },
  "RateLimits": {
    "ConversionsPerMinute": 120
  }
}
