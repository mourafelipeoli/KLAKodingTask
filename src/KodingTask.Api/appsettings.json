{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MySqlServerVersion": "8.4.0"
  },
  "ConnectionStrings": {
    "KodingTask": "Data Source=App_Data/kodingtask.db"
  },
  "PublicSite": {
    "Url": "https://klakodingtask.mourafelipe.com",
    "RepositoryUrl": "",
    "AuthorName": "Felipe Moura",
    "AuthorUrl": "https://mourafelipe.com",
    "AuthorTerminalUrl": "https://mourafelipe.com/terminal"
  },
  "RateLimits": {
    "ConversionsPerMinute": 120,
    "AiPerMinute": 10,
    "InfrastructurePerMinute": 30,
    "AccountPerMinute": 20
  },
  "Limits": {
    "SsmPath": "",
    "SsmRegion": "",
    "CacheSeconds": 60,
    "KillSwitch": false,
    "AiCallsPerDay": 200,
    "AiCallsPerClientPerDay": 20,
    "AiMonthlyBudgetUsd": 2,
    "EmailsPerDay": 100,
    "WhatsAppPerDay": 50,
    "DeliveriesPerUserPerDay": 10,
    "PhoneCodesPerUserPerDay": 3,
    "AccountEmailsPerUserPerDay": 3,
    "RegistrationsPerClientPerDay": 5
  },
  "Ai": {
    "ModelId": "",
    "Region": "",
    "ModelLabel": "Claude Haiku 5.5 on Amazon Bedrock",
    "MaxOutputTokens": 2000,
    "Effort": "",
    "MaxConcurrency": 2,
    "TimeoutSeconds": 30
  },
  "Email": {
    "Sender": "",
    "SenderName": "Koding Task",
    "Region": "",
    "ConfigurationSet": "",
    "Mode": "Ses"
  },
  "WhatsApp": {
    "ApiBaseUrl": "https://graph.facebook.com/v22.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "ResultTemplate": "koding_task_result",
    "CodeTemplate": "koding_task_code",
    "FallbackLanguage": "en_US",
    "TimeoutSeconds": 15,
    "Mode": "Meta"
  },
  "Infrastructure": {
    "DatabaseInstanceId": "",
    "CertificateArn": "",
    "CacheMinutes": 5,
    "AwsCallTimeoutSeconds": 5
  },
  "Privacy": {
    "ClientHashKey": ""
  }
}
