{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MySqlServerVersion": "8.4.0"
  },
  "ConnectionStrings": {
    "KodingTask": "Data Source=App_Data/kodingtask.db"
  },
  "PublicSite": {
    "Url": "https://klakodingtask.mourafelipe.com",
    "RepositoryUrl": "",
    "AuthorName": "Felipe Moura",
    "AuthorUrl": "https://mourafelipe.com"
  },
  "RateLimits": {
    "ConversionsPerMinute": 120,
    "AiPerMinute": 10
  },
  "Limits": {
    "SsmPath": "",
    "SsmRegion": "",
    "CacheSeconds": 60,
    "KillSwitch": false,
    "AiCallsPerDay": 200,
    "AiCallsPerClientPerDay": 20,
    "AiMonthlyBudgetUsd": 2
  },
  "Ai": {
    "ModelId": "",
    "Region": "",
    "ModelLabel": "Claude Haiku 5.5 on Amazon Bedrock",
    "MaxOutputTokens": 2000,
    "Effort": "",
    "MaxConcurrency": 2,
    "TimeoutSeconds": 30
  },
  "Privacy": {
    "ClientHashKey": ""
  }
}
